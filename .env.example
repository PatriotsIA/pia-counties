VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public base URL for the separately deployed Mighty Networks proxy API.
# Do not add MIGHTY_API_KEY or MIGHTY_NETWORK_ID to this frontend project.
VITE_MIGHTY_API_BASE=https://your-mighty-api.example.com

# Candidate submission/directory API and Cognito reviewer login.
# Copy these values from the pia-candidate-api CloudFormation stack outputs.
VITE_CANDIDATE_API_BASE=https://your-candidate-api.example.com
VITE_CANDIDATE_COGNITO_REGION=us-east-1
VITE_CANDIDATE_COGNITO_CLIENT_ID=

# Optional, only needed for /tv Vimeo proxy on deployments.
PIA_VIMEO_ACCESS_TOKEN=
